{
  "name": "nitro-logger-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "specs": "bun run --cwd packages/react-native-nitro-logger specs",
    "build": "tsc -p packages/react-native-nitro-logger/tsconfig.json",
    "typecheck": "tsc -p packages/react-native-nitro-logger/tsconfig.json --noEmit && tsc -p apps/example/tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "bun test tests",
    "format": "prettier --write packages/react-native-nitro-logger/src tests apps/example/src docs README.md",
    "format:check": "prettier --check packages/react-native-nitro-logger/src tests apps/example/src docs README.md",
    "check": "bun run specs && bun run build && bun run typecheck && bun test && bun run format:check",
    "example": "bun run --cwd apps/example",
    "package:check": "bun run build && node scripts/check-package.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "release": "./scripts/release.sh",
    "release:test": "node scripts/test-release-flow.mjs"
  },
  "devDependencies": {
    "@release-it/bumper": "8.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/bun": "1.4.1",
    "nitrogen": "0.37.1",
    "prettier": "3.8.3",
    "release-it": "21.0.3",
    "typescript": "6.0.3"
  },
  "version": "0.2.0",
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true
    },
    "hooks": {
      "before:release": "bun run build && bun run specs",
      "after:bump": "bun install --lockfile-only --ignore-scripts && node scripts/sync-workspace-versions.mjs"
    },
    "plugins": {
      "@release-it/bumper": {
        "out": [
          {
            "file": "packages/react-native-nitro-logger/package.json",
            "path": "version"
          },
          {
            "file": "apps/example/package.json",
            "path": "version"
          }
        ]
      },
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits"
      }
    }
  }
}
