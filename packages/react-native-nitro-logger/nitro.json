{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitrologger"
  ],
  "ios": {
    "iosModuleName": "NitroLogger"
  },
  "android": {
    "androidNamespace": [
      "nitrologger"
    ],
    "androidCxxLibName": "NitroLogger"
  },
  "autolinking": {
    "SystemLogFactory": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSystemLogFactory"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSystemLogFactory"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
